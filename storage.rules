rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // ── Helper functions ──
    function isAuth() {
      return request.auth != null;
    }
    function isSuperAdmin() {
      return isAuth() && (
        request.auth.token.isSuperAdmin == true ||
        request.auth.token.role == 'super_admin'
      );
    }
    function myShopId() {
      return request.auth.token.shopId;
    }
    function canAccessBackupShop(shopId) {
      return isAuth() && (
        isSuperAdmin() ||
        myShopId() == shopId ||
        myShopId() == null
      );
    }
    // Max 10 MB per upload
    function withinSizeLimit() {
      return request.resource.size <= 10 * 1024 * 1024;
    }
    // Only image content types
    function isImage() {
      return request.resource.contentType.matches('image/.*');
    }

    // ── Shop-isolated paths (chat_images/{shopId}/*, payment_requests/{shopId}/*) ──
    match /chat_images/{shopId}/{fileName} {
      allow read:   if isAuth() && (isSuperAdmin() || myShopId() == shopId);
      allow write:  if isAuth() && (isSuperAdmin() || myShopId() == shopId)
                       && withinSizeLimit() && isImage();
    }
    match /payment_requests/{shopId}/{fileName} {
      allow read:   if isAuth() && (isSuperAdmin() || myShopId() == shopId);
      allow write:  if isAuth() && (isSuperAdmin() || myShopId() == shopId)
                       && withinSizeLimit() && isImage();
    }

    // ── Shared folders (no shopId in path — auth + size + type guard) ──
    match /repairs/{fileName} {
      allow read:   if isAuth();
      allow write:  if isAuth() && withinSizeLimit() && isImage();
    }
    match /repairs/{shopId}/{fileName} {
      allow read:   if isAuth() && (isSuperAdmin() || myShopId() == shopId);
      allow write:  if isAuth() && (isSuperAdmin() || myShopId() == shopId)
                       && withinSizeLimit() && isImage();
    }
    match /attendance/{fileName} {
      allow read:   if isAuth();
      allow write:  if isAuth() && withinSizeLimit() && isImage();
    }
    match /shop_logos/{fileName} {
      allow read:   if isAuth();
      allow write:  if isAuth() && withinSizeLimit() && isImage();
    }
    match /user_photos/{uid}/{fileName} {
      allow read:   if isAuth();
      allow write:  if isAuth() && (isSuperAdmin() || request.auth.uid == uid)
                       && withinSizeLimit() && isImage();
    }
    match /user_photos/{fileName} {
      allow read:   if isAuth();
      allow write:  if isAuth() && withinSizeLimit() && isImage();
    }
    match /products/{fileName} {
      allow read:   if isAuth();
      allow write:  if isAuth() && withinSizeLimit() && isImage();
    }

    // ── SQLite / Firestore backup files in Storage ──
    // Path examples:
    // - db_backups/{shopId}/backup_123.db
    // - db_backups/{shopId}/fs_123/repairs.json
    match /db_backups/{shopId}/{allPaths=**} {
      allow read: if canAccessBackupShop(shopId);
      allow create, update: if canAccessBackupShop(shopId)
                            && request.resource.size <= 250 * 1024 * 1024;
      allow delete: if canAccessBackupShop(shopId);
    }

    // ── Deny everything else ──
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}